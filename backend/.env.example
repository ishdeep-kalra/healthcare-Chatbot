# FastAPI Configuration
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# Security
# In production, set this to actual frontend origin (e.g., https://yourdomain.com)
CORS_ORIGINS=["https://your-frontend.vercel.app","http://localhost:5173"]

# LLM Provider: "gemini" (default, recommended for Render) or "ollama" (local only)
LLM_PROVIDER=gemini

# Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Ollama settings (only used when LLM_PROVIDER=ollama, for local development)
OLLAMA_MODEL=llama3.2

# ChromaDB Settings (unused — JSON-based local storage is used instead)
CHROMA_PERSIST_DIR=../data/chromadb
